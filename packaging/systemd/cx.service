[Unit]
Description=Clashix (cx) proxy service
Documentation=https://github.com/DawnMagnet/clashix-go
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# The service keeps its active config and geodata under /var/lib/cx.
# Seed it with `cx serve --config ...` or `cx sub update --dir /var/lib/cx --sub ...`.
# Optional environment file (CX_SUB, CX_SELECT, CX_SECRET, CX_UI_ADDR, ...).
EnvironmentFile=-/etc/cx/cx.env
ExecStart=/usr/local/bin/cx serve --dir /var/lib/cx
ExecReload=/bin/kill -HUP $MAINPID
StateDirectory=cx
StateDirectoryMode=0700
Restart=always
RestartSec=5s
LimitNOFILE=1048576

# Hardening for ordinary proxy-only operation. For TUN mode add the following
# (and keep PrivateDevices off; it is not enabled here):
# AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
# CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
# DeviceAllow=/dev/net/tun rw
# PrivateDevices=no
# CAP_NET_ADMIN creates and routes the TUN device; CAP_NET_BIND_SERVICE lets
# mihomo's DNS listener bind port 53.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

# Without TUN, run as an unprivileged user:
# User=cx
# Group=cx

[Install]
WantedBy=multi-user.target
